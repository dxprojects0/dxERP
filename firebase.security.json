{
  "version": 2,
  "policies": {
    "userScopedData": {
      "paths": [
        "users/{uid}/profile/data",
        "users/{uid}/dashboard/data",
        "users/{uid}/inventory/data",
        "users/{uid}/tasks/data",
        "usersSummary/{uid}"
      ],
      "allowRead": "auth.uid == uid || requesterRole == 'admin'",
      "allowWrite": "auth.uid == uid || requesterRole == 'admin'",
      "notes": "All application data is scoped by auth.uid only."
    },
    "adminManagement": {
      "paths": [
        "adminAccounts/{uid}",
        "adminManagement/{docId}",
        "marketingUsers/{code}",
        "PaidInterests/{requestId}"
      ],
      "allowRead": "requesterRole == 'admin' OR public-read for marketingUsers/{code}",
      "allowWrite": "requesterRole == 'admin' OR owner-create for PaidInterests/{requestId}",
      "notes": "Centralized admin and management collections."
    }
  },
  "profileSchema": {
    "document": "users/{uid}/profile/data",
    "requiredFields": [
      "uid",
      "email",
      "name",
      "role",
      "plan",
      "businessName",
      "shopName",
      "ownerName",
      "selectedProfessionId",
      "phoneNumber",
      "onboardingCompleted",
      "updatedAt"
    ]
  },
  "summarySchema": {
    "document": "usersSummary/{uid}",
    "requiredFields": [
      "uid",
      "email",
      "ownerName",
      "shopName",
      "phoneNumber",
      "category",
      "plan",
      "displayLabel",
      "businessLabel",
      "updatedAt"
    ],
    "notes": "Readable admin-facing user directory with owner/business labels plus email."
  },
  "paidInterestSchema": {
    "document": "PaidInterests/{email_plan}",
    "requiredFields": [
      "requestId",
      "uid",
      "email",
      "ownerName",
      "businessName",
      "phoneNumber",
      "requestedPlan",
      "displayLabel",
      "businessLabel",
      "createdAt"
    ],
    "notes": "Paid plan requests use email-based document ids and readable labels for easier admin scanning."
  }
}
